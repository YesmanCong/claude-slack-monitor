+func TestWatchDropsCatchupEventsFromPreviousConnections(t *testing.T) {
+	var stdout bytes.Buffer
+	output := &watchOutput{encoder: json.NewEncoder(&stdout)}
+	first := output.connect(time.Unix(200, 0))
+	output.disconnect(time.Unix(205, 0))
+	if output.emitForSession(first, watchEvent{Event: "caught_up", Through: 200}) {
+		t.Fatal("disconnected session accepted a checkpoint")
+	}
+	second := output.connect(time.Unix(210, 0))
+	if output.emitForSession(first, watchEvent{Event: "caught_up", Through: 200}) {
+		t.Fatal("superseded session accepted a checkpoint")
+	}
+	if !output.emitForSession(second, watchEvent{Event: "caught_up", Through: 210}) {
+		t.Fatal("current session rejected a checkpoint")
+	}
+	if got := stdout.String(); strings.Count(got, "caught_up") != 1 {
+		t.Fatalf("unexpected output: %s", got)
+	}
+}
+
+func TestWatchReconnectOnlySkipsPreviouslyRecoveredOnlineTime(t *testing.T) {
+	var stdout bytes.Buffer
+	output := &watchOutput{encoder: json.NewEncoder(&stdout)}
+	first := output.connect(time.Unix(200, 0))
+	output.emitForSession(first, watchEvent{Event: "caught_up", Through: 200})
+	output.disconnect(time.Unix(7200, 0))
+	second := output.connect(time.Unix(7210, 0))
+	if got := second.resumeSince.Unix(); got != 7140 {
+		t.Fatalf("resume since %d, want 7140", got)
+	}
+	output.emitForSession(second, watchEvent{Event: "catchup_error"})
+	output.disconnect(time.Unix(18000, 0))
+	third := output.connect(time.Unix(18010, 0))
+	if got := third.resumeSince; got != second.resumeSince {
+		t.Fatalf("advanced over an unrecovered gap to %v", got)
+	}
+
+	recovery := make(chan watchSession, 1)
+	recovery <- third
+	close(recovery)
+	runWatchCatchup(context.Background(), output, recovery, time.Unix(200, 0),
+		func(_ context.Context, start, end time.Time) ([]recentMessage, int, error) {
+			if start != third.resumeSince || end != third.through {
+				t.Fatalf("unexpected recovery window %v to %v", start, end)
+			}
+			return []recentMessage{{Text: "newer"}, {Text: "older"}}, 0, nil
+		})
+	lines := strings.Split(strings.TrimSpace(stdout.String()), "\n")
+	if len(lines) < 3 || !strings.Contains(lines[len(lines)-3], "older") || !strings.Contains(lines[len(lines)-2], "newer") ||
+		lines[len(lines)-1] != `{"__event__":"caught_up","through":18010}` {
+		t.Fatalf("unexpected catchup order: %s", stdout.String())
+	}
+}
