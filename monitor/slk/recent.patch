+func TestWatchCatchupPreservesPartialWatermark(t *testing.T) {
+	var stdout bytes.Buffer
+	output := &watchOutput{encoder: json.NewEncoder(&stdout)}
+	first := output.connect(time.Unix(200, 0))
+	recovery := make(chan watchSession, 2)
+	recovery <- first
+	recovery <- watchSession{id: first.id, through: time.Unix(210, 0)}
+	close(recovery)
+	var starts, ends []int64
+	runWatchCatchup(context.Background(), output, recovery, time.Unix(100, 0),
+		func(_ context.Context, start, end time.Time) ([]recentMessage, int, error) {
+			starts = append(starts, start.Unix())
+			ends = append(ends, end.Unix())
+			if end.Unix() == 200 {
+				return []recentMessage{{Text: "available despite partial response"}}, 1, nil
+			}
+			return []recentMessage{{Text: "recovered"}}, 0, nil
+		})
+	if !reflect.DeepEqual(starts, []int64{100, 100}) || !reflect.DeepEqual(ends, []int64{200, 210}) {
+		t.Fatalf("incorrect windows: %v to %v", starts, ends)
+	}
+	lines := strings.Split(strings.TrimSpace(stdout.String()), "\n")
+	if len(lines) != 5 || !strings.Contains(lines[1], "available despite partial response") ||
+		lines[2] != `{"__event__":"catchup_error"}` || !strings.Contains(lines[3], "recovered") ||
+		lines[4] != `{"__event__":"caught_up","through":210}` {
+		t.Fatalf("unexpected output: %s", stdout.String())
+	}
+}
