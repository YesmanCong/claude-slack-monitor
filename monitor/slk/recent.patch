index 0000000..d524a33
--- /dev/null
+++ b/cmd/slk/watch_command_test.go
@@ -0,0 +1,151 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/slack-go/slack"
+)
+
+func TestWatchMessageOutput(t *testing.T) {
+	var stdout bytes.Buffer
+	handler := watchHandler{
+		ctx: context.Background(), output: &watchOutput{encoder: json.NewEncoder(&stdout)},
+		workspaceURL: "https://test.slack.com", conversations: make(map[string]watchConversation),
+	}
+	var lookedUp []string
+	handler.conversationInfo = func(_ context.Context, id string) (*slack.Channel, error) {
+		lookedUp = append(lookedUp, id)
+		return &slack.Channel{GroupConversation: slack.GroupConversation{
+			Conversation: slack.Conversation{ID: id, IsMpIM: id == "GDM" || id == "CDM"}, Name: id,
+		}}, nil
+	}
+	blocks := slack.Blocks{BlockSet: []slack.Block{slack.NewSectionBlock(
+		slack.NewTextBlockObject("mrkdwn", "review requested", false, false), nil, nil,
+	)}}
+	handler.OnConversationOpened(slack.Channel{GroupConversation: slack.GroupConversation{
+		Conversation: slack.Conversation{ID: "CJOINED", IsMpIM: true}, Name: "CJOINED",
+	}})
+	handler.OnMessage("GDM", "", "1795427870.099969", "", "1795427800.001234", "bot_message", false, false, nil, blocks, nil, "B1", "GitHub")
+	handler.OnMessage("GDM", "U1", "1795427871.000001", "ordinary", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("GPRIVATE", "U1", "1795427872.000001", "<@U2> see this", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("CDM", "U1", "1795427872.000002", "group", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("CJOINED", "U1", "1795427872.000003", "joined group", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("CPUBLIC", "U1", "1795427872.000004", "channel", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("CPUBLIC", "U1", "1795427872.000005", "channel again", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("D1", "U1", "1795427873.000001", "direct", "", "", false, false, nil, slack.Blocks{}, nil, "", "")
+	handler.OnMessage("D1", "U1", "1795427873.000001", "edited", "", "", true, true, nil, slack.Blocks{}, nil, "", "")
+	handler.OnReactionAdded("D1", "1795427873.000001", "U1", "eyes")
+
+	if !reflect.DeepEqual(lookedUp, []string{"GDM", "GPRIVATE", "CDM", "CPUBLIC"}) {
+		t.Fatalf("looked up %v", lookedUp)
+	}
+	var messages []recentMessage
+	for line := range strings.SplitSeq(strings.TrimSpace(stdout.String()), "\n") {
+		var message recentMessage
+		if err := json.Unmarshal([]byte(line), &message); err != nil {
+			t.Fatal(err)
+		}
+		messages = append(messages, message)
+	}
+	if len(messages) != 8 {
+		t.Fatalf("got %d messages", len(messages))
+	}
+	bot := messages[0]
+	if !bot.IsBot || !bot.IsDM || bot.AuthorID != "B1" || bot.AuthorName != "GitHub" ||
+		bot.Text != "review requested" || !strings.Contains(bot.Permalink, "?thread_ts=1795427800.001234&cid=GDM") {
+		t.Fatalf("unexpected bot message: %+v", bot)
+	}
+	if !messages[1].IsDM || messages[2].IsDM || messages[2].Text != "<@U2> see this" || !messages[3].IsDM ||
+		!messages[4].IsDM || messages[5].IsDM || messages[6].IsDM || !messages[7].IsDM {
+		t.Fatalf("incorrect DM routing: %+v", messages)
+	}
+}
