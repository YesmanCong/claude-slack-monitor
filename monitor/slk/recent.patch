diff --git a/cmd/slk/recent_command.go b/cmd/slk/recent_command.go
new file mode 100644
index 0000000..d3cd815
--- /dev/null
+++ b/cmd/slk/recent_command.go
@@ -0,0 +1,159 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"os"
+	"os/signal"
+	"path/filepath"
+	"sort"
+	"time"
+
+	"github.com/gammons/slk/internal/config"
+	"github.com/gammons/slk/internal/core"
+	"github.com/gammons/slk/internal/export"
+	"github.com/gammons/slk/internal/ids"
+	slackclient "github.com/gammons/slk/internal/slack"
+	"github.com/gammons/slk/internal/slackurl"
+)
+
+type recentMessage struct {
+	Kind      string `json:"kind"`
+	ChannelID string `json:"channel_id"`
+	TS        string `json:"ts"`
+	ThreadTS  string `json:"thread_ts,omitempty"`
+	AuthorID  string `json:"author_id"`
+	IsBot     bool   `json:"is_bot"`
+	Text      string `json:"text"`
+	Permalink string `json:"permalink,omitempty"`
+}
+
+func runRecent(args []string) error {
+	flags := flag.NewFlagSet("slk recent", flag.ContinueOnError)
+	window := flags.Duration("within", 10*time.Minute, "read activity targeting messages in this time window")
+	workspace := flags.String("workspace", "", "configured workspace slug, ID, or name")
+	if err := flags.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return err
+	}
+	if flags.NArg() != 0 || *window <= 0 {
+		return errors.New("expected only flags and a positive --within duration")
+	}
+
+	store := slackclient.NewTokenStore(filepath.Join(xdgData(), "tokens"))
+	tokens, err := store.List()
+	if err != nil {
+		return fmt.Errorf("list workspaces: %w", err)
+	}
+	cfg, _ := config.Load(filepath.Join(xdgConfig(), "config.toml"))
+	selected, err := selectExportToken(config.OrderTokens(tokens, cfg), *workspace)
+	if err != nil {
+		return err
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
+	defer stop()
+	ctx, cancel := context.WithTimeout(ctx, 45*time.Second)
+	defer cancel()
+	client := slackclient.NewClient(selected.AccessToken, selected.Cookie)
+	if err := client.Connect(ctx); err != nil {
+		return err
+	}
+	end := time.Now().Truncate(time.Second)
+	items, err := recentActivity(end.Add(-*window), end, func(cursor string) (slackclient.ActivityFeedResult, error) {
+		return client.GetActivityFeed(ctx, 40, cursor, false)
+	})
+	if err != nil {
+		return err
+	}
+
+	messages := make([]recentMessage, 0, len(items))
+	if len(items) == 0 {
+		return json.NewEncoder(os.Stdout).Encode(messages)
+	}
+	refs := make(map[string][]string)
+	for _, item := range items {
+		refs[item.ChannelID] = append(refs[item.ChannelID], item.TS)
+	}
+	bodies, err := client.GetActivityMessages(ctx, refs)
+	if err != nil {
+		return err
+	}
+	unavailable := 0
+	workspaceURL := "https://" + client.TeamSubdomain() + ".slack.com"
+	for _, item := range items {
+		body, ok := bodies[core.ActivityMsgKey(item.ChannelID, item.TS)]
+		if !ok {
+			unavailable++
+			continue
+		}
+		author := body.UserID
+		if author == "" {
+			author = item.AuthorID
+		}
+		if author == client.UserID() {
+			continue
+		}
+		link, ok := slackurl.Build(workspaceURL, ids.ChannelID(item.ChannelID), ids.MessageTS(item.TS), ids.ThreadTS(item.ThreadTS))
+		if !ok {
+			link, err = client.GetPermalink(ctx, item.ChannelID, item.TS, item.ThreadTS)
+			if err != nil {
+				fmt.Fprintf(os.Stderr, "could not resolve permalink for %s at %s\n", item.ChannelID, item.TS)
+			}
+		}
+		messages = append(messages, recentMessage{Kind: item.Type, ChannelID: item.ChannelID,
+			TS: item.TS, ThreadTS: item.ThreadTS, AuthorID: author,
+			IsBot: item.IsBot || item.Type == "bot_dm_bundle", Text: body.Text, Permalink: link})
+	}
+	if unavailable > 0 {
+		fmt.Fprintf(os.Stderr, "skipped %d unavailable activity messages\n", unavailable)
+	}
+	return json.NewEncoder(os.Stdout).Encode(messages)
+}
+
+func recentActivity(start, end time.Time, fetch func(string) (slackclient.ActivityFeedResult, error)) ([]core.ActivityItem, error) {
+	var items []core.ActivityItem
+	seenMessages := map[string]bool{}
+	seenCursors := map[string]bool{}
+	for cursor := ""; ; {
+		page, err := fetch(cursor)
+		if err != nil {
+			return nil, err
+		}
+		pastWindow := false
+		for _, item := range page.Items {
+			if feedTime, ok := export.TimeFromTS(item.FeedTS); ok && feedTime.Before(start) {
+				pastWindow = true
+			}
+			switch item.Type {
+			case "at_user", "unjoined_channel_mention", "dm", "bot_dm_bundle", "thread_v2":
+			default:
+				continue
+			}
+			ts, valid := export.TimeFromTS(item.TS)
+			if !valid || ts.Before(start) || ts.After(end) || item.ChannelID == "" {
+				continue
+			}
+			key := core.ActivityMsgKey(item.ChannelID, item.TS)
+			if !seenMessages[key] {
+				seenMessages[key] = true
+				items = append(items, item)
+			}
+		}
+		if pastWindow || page.NextCursor == "" {
+			break
+		}
+		if seenCursors[page.NextCursor] {
+			return nil, errors.New("activity feed repeated a pagination cursor")
+		}
+		cursor = page.NextCursor
+		seenCursors[cursor] = true
+	}
+	sort.SliceStable(items, func(i, j int) bool { return items[i].TS > items[j].TS })
+	return items, nil
+}
