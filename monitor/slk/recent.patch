@@ -0,0 +1,35 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+	"time"
+
+	"github.com/gammons/slk/internal/core"
+	slackclient "github.com/gammons/slk/internal/slack"
+)
+
+func TestRecentActivityFindsMessagesAcrossPages(t *testing.T) {
+	direct := core.ActivityItem{Type: "dm", ChannelID: "D1", TS: "190.000001", FeedTS: "200.000001"}
+	reply := core.ActivityItem{Type: "thread_v2", ChannelID: "C1", TS: "180.000002", FeedTS: "195.000001"}
+	mention := core.ActivityItem{Type: "at_user", ChannelID: "C1", TS: "175.000001", FeedTS: "191.000001"}
+	reaction := core.ActivityItem{Type: "message_reaction", ChannelID: "C2", TS: "199.000001", FeedTS: "199.000001"}
+	old := core.ActivityItem{Type: "at_user", ChannelID: "C2", TS: "90.000001", FeedTS: "90.000001"}
+	pages := map[string]slackclient.ActivityFeedResult{
+		"":     {Items: []core.ActivityItem{direct, reaction, reply}, NextCursor: "next"},
+		"next": {Items: []core.ActivityItem{reply, mention, old}, NextCursor: "older"},
+	}
+	items, err := recentActivity(time.Unix(100, 0), time.Unix(200, 0), func(cursor string) (slackclient.ActivityFeedResult, error) {
+		page, ok := pages[cursor]
+		if !ok {
+			t.Fatalf("requested an older page: %q", cursor)
+		}
+		return page, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := []core.ActivityItem{direct, reply, mention}; !reflect.DeepEqual(items, want) {
+		t.Fatalf("got %+v, want %+v", items, want)
+	}
+}
diff --git a/cmd/slk/watch_command.go b/cmd/slk/watch_command.go
new file mode 100644
index 0000000..b30a7c7
--- /dev/null
+++ b/cmd/slk/watch_command.go
@@ -0,0 +1,341 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"os"
+	"os/signal"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/gammons/slk/internal/core"
+	"github.com/gammons/slk/internal/ids"
+	slackclient "github.com/gammons/slk/internal/slack"
+	"github.com/gammons/slk/internal/slackurl"
+	"github.com/gammons/slk/internal/ui/messages/blockkit"
+	"github.com/slack-go/slack"
+)
+
+type watchEvent struct {
+	Event   string `json:"__event__"`
+	Code    string `json:"code,omitempty"`
+	Through int64  `json:"through,omitempty"`
+}
+
+type watchSession struct {
+	id          uint64
+	through     time.Time
+	resumeSince time.Time
+}
+
+type watchOutput struct {
+	mu          sync.Mutex
+	encoder     *json.Encoder
+	cancel      context.CancelFunc
+	err         error
+	session     uint64
+	connected   bool
+	recovered   bool
+	resumeSince time.Time
+}
+
+func (s *watchOutput) emitLocked(row any) {
+	if s.err == nil {
+		if s.err = s.encoder.Encode(row); s.err != nil {
+			s.cancel()
+		}
+	}
+}
+
+func (s *watchOutput) emit(row any) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.emitLocked(row)
+}
+
+func (s *watchOutput) connect(through time.Time) watchSession {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.session++
+	s.connected = true
+	s.recovered = false
+	s.emitLocked(watchEvent{Event: "connected"})
+	return watchSession{id: s.session, through: through, resumeSince: s.resumeSince}
+}
+
+func (s *watchOutput) disconnect(at time.Time) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.connected && s.recovered {
+		// Upstream can take a minute to detect a silently dropped socket.
+		// Recover that overlap and any time since, without replaying the
+		// full lifetime of a socket whose initial gap was recovered.
+		if since := at.Add(-time.Minute); since.After(s.resumeSince) {
+			s.resumeSince = since
+		}
+	}
+	s.connected = false
+	s.emitLocked(watchEvent{Event: "disconnected"})
+}
+
+func (s *watchOutput) emitForSession(session watchSession, event watchEvent) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.connected || s.session != session.id {
+		return false
+	}
+	s.emitLocked(event)
+	if s.err == nil && event.Event == "caught_up" {
+		s.recovered = true
+	}
+	return s.err == nil
+}
+
+func (s *watchOutput) writeError() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.err
+}
+
+func runWatch(args []string) error {
+	flags := flag.NewFlagSet("slk watch", flag.ContinueOnError)
+	workspace := flags.String("workspace", "", "configured workspace slug, ID, or name")
+	since := flags.Int64("since", 0, "catch up from a Unix timestamp in seconds (defaults to ten minutes ago)")
+	if err := flags.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return err
+	}
+	if flags.NArg() != 0 || *since < 0 || *since > time.Now().Unix() {
+		return errors.New("expected only flags and a valid --since Unix timestamp")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	output := &watchOutput{encoder: json.NewEncoder(os.Stdout), cancel: cancel}
+	selected, err := activityWorkspace(*workspace)
+	if err != nil {
+		output.emit(watchEvent{Event: "error", Code: "no_workspace"})
+		return errors.New("unable to select a configured Slack workspace")
+	}
+	client := slackclient.NewClient(selected.AccessToken, selected.Cookie)
+	if err := client.Connect(ctx); err != nil {
+		output.emit(watchEvent{Event: "error", Code: "auth_failed"})
+		return errors.New("unable to authenticate the configured Slack workspace")
+	}
+
+	start := time.Unix(*since, 0)
+	if *since == 0 {
+		start = time.Now().Truncate(time.Second).Add(-10 * time.Minute)
+	}
+	handler := &watchHandler{
+		ctx: ctx, output: output, recovery: make(chan watchSession, 1),
+		workspaceURL:     "https://" + client.TeamSubdomain() + ".slack.com",
+		conversations:    make(map[string]watchConversation),
+		conversationInfo: client.GetConversationInfo,
+	}
+	if channels, err := client.GetChannels(ctx); err == nil {
+		for _, channel := range channels {
+			handler.OnConversationOpened(channel)
+		}
+	}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		runWatchCatchup(ctx, output, handler.recovery, start,
+			func(ctx context.Context, start, end time.Time) ([]recentMessage, int, error) {
+				return readRecentMessages(ctx, client, start, end)
+			})
+	}()
+	slackclient.NewConnectionManager(client, handler).Run(ctx)
+	cancel()
+	<-done
+	return output.writeError()
+}
+
+type watchCatchupReader func(context.Context, time.Time, time.Time) ([]recentMessage, int, error)
+
+func runWatchCatchup(ctx context.Context, output *watchOutput, recovery <-chan watchSession, start time.Time, read watchCatchupReader) {
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case session, open := <-recovery:
+			if !open {
+				return
+			}
+			since := start
+			if session.resumeSince.After(since) {
+				since = session.resumeSince
+			}
+			if session.through.Before(since) {
+				continue
+			}
+			request, cancel := context.WithTimeout(ctx, 45*time.Second)
+			messages, unavailable, err := read(request, since, session.through)
+			cancel()
+			if ctx.Err() != nil {
+				return
+			}
+			for i := len(messages) - 1; i >= 0; i-- {
+				output.emit(messages[i])
+			}
+			if err != nil || unavailable > 0 {
+				output.emitForSession(session, watchEvent{Event: "catchup_error"})
+				continue
+			}
+			if output.emitForSession(session, watchEvent{Event: "caught_up", Through: session.through.Unix()}) {
+				start = session.through
+			}
+		}
+	}
+}
+
+type watchConversation struct {
+	name       string
+	isDM       bool
+	retryAfter time.Time
+}
+
+type watchHandler struct {
+	ctx              context.Context
+	output           *watchOutput
+	recovery         chan watchSession
+	workspaceURL     string
+	conversations    map[string]watchConversation
+	conversationInfo func(context.Context, string) (*slack.Channel, error)
+}
+
+var _ slackclient.EventHandler = (*watchHandler)(nil)
+
+func (h *watchHandler) OnConnect() {
+	session := h.output.connect(time.Now().Truncate(time.Second))
+	select {
+	case h.recovery <- session:
+	default:
+		// The fetch worker may still be processing an earlier connection.
+		// Its watermark covers the gap through the latest queued session.
+		select {
+		case <-h.recovery:
+		default:
+		}
+		h.recovery <- session
+	}
+}
+
+func (h *watchHandler) OnDisconnect() {
+	h.output.disconnect(time.Now().Truncate(time.Second))
+}
+
+func (h *watchHandler) OnMessage(channelID, userID, ts, text, threadTS, subtype string, changed, _ bool, files []slack.File, blocks slack.Blocks, attachments []slack.Attachment, botID, username string) {
+	if changed || core.IsSystemNoticeSubtype(subtype) || channelID == "" || ts == "" {
+		return
+	}
+	conversation := h.conversation(channelID)
+	link, _ := slackurl.Build(h.workspaceURL, ids.ChannelID(channelID), ids.MessageTS(ts), ids.ThreadTS(threadTS))
+	authorID := userID
+	if authorID == "" {
+		authorID = botID
+	}
+	if text == "" {
+		text = watchFallbackText(blocks, attachments, files)
+	}
+	h.output.emit(recentMessage{
+		Kind: "message", ChannelID: channelID, ChannelName: conversation.name, TS: ts, ThreadTS: threadTS,
+		AuthorID: authorID, AuthorName: username, IsBot: botID != "" || subtype == "bot_message",
+		IsDM: conversation.isDM, Text: text, Permalink: link,
+	})
+}
+
+func (h *watchHandler) OnConversationOpened(ch slack.Channel) {
+	if ch.ID != "" {
+		h.conversations[ch.ID] = watchConversation{name: ch.Name, isDM: ch.IsIM || ch.IsMpIM || strings.HasPrefix(ch.ID, "D")}
+	}
+}
+
+func (h *watchHandler) conversation(channelID string) watchConversation {
+	if conversation, found := h.conversations[channelID]; found {
+		if conversation.retryAfter.IsZero() || time.Now().Before(conversation.retryAfter) {
+			return conversation
+		}
+	}
+	// Group DMs can have C or G IDs, so only D IDs are known without a lookup.
+	if strings.HasPrefix(channelID, "D") {
+		return watchConversation{isDM: true}
+	}
+
+	ctx, cancel := context.WithTimeout(h.ctx, 2*time.Second)
+	defer cancel()
+	conversation, err := h.conversationInfo(ctx, channelID)
+	if err == nil && conversation != nil && conversation.ID == channelID {
+		h.OnConversationOpened(*conversation)
+	} else {
+		h.conversations[channelID] = watchConversation{retryAfter: time.Now().Add(time.Minute)}
+	}
+	return h.conversations[channelID]
+}
+
+func watchFallbackText(blocks slack.Blocks, attachments []slack.Attachment, files []slack.File) string {
+	var text []string
+	appendBlocks := func(blocks slack.Blocks) {
+		for _, block := range blockkit.Parse(blocks) {
+			switch b := block.(type) {
+			case blockkit.RichTextBlock:
+				text = append(text, blockkit.RichTextToMrkdwn(b))
+			case blockkit.HeaderBlock:
+				text = append(text, b.Text)
+			case blockkit.SectionBlock:
+				text = append(text, b.Text)
+				text = append(text, b.Fields...)
+			}
+		}
+	}
+	appendBlocks(blocks)
+	for _, attachment := range attachments {
+		if attachment.Text != "" {
+			text = append(text, attachment.Text)
+		} else {
+			text = append(text, attachment.Fallback)
+		}
+		appendBlocks(attachment.Blocks)
+	}
+	for _, file := range files {
+		text = append(text, file.Title)
+	}
+	return strings.TrimSpace(strings.Join(text, "\n"))
+}
+
+func (*watchHandler) OnEphemeralMessage(slackclient.EphemeralMessage)  {}
+func (*watchHandler) OnViewOpened(string)                              {}
+func (*watchHandler) OnMessageDeleted(string, string)                  {}
+func (*watchHandler) OnReactionAdded(string, string, string, string)   {}
+func (*watchHandler) OnReactionRemoved(string, string, string, string) {}
+func (*watchHandler) OnPresenceChange(string, string)                  {}
+func (*watchHandler) OnUserTyping(string, string)                      {}
+func (*watchHandler) OnAssistantStatus(slackclient.AssistantStatus)    {}
+func (*watchHandler) OnSelfPresenceChange(string)                      {}
+func (*watchHandler) OnDNDChange(bool, int64)                          {}
+func (*watchHandler) OnBadgeCountsUpdated(int)                         {}
+func (*watchHandler) OnChannelMarked(string, string, int, int)         {}
+func (*watchHandler) OnThreadMarked(string, string, string, slackclient.Subscribed) {
+}
+func (*watchHandler) OnThreadSubscriptionChanged(string, string, string, bool)    {}
+func (*watchHandler) OnChannelSectionUpserted(slackclient.ChannelSectionUpserted) {}
+func (*watchHandler) OnChannelSectionDeleted(string)                              {}
+func (*watchHandler) OnChannelSectionChannelsUpserted(string, []string)           {}
+func (*watchHandler) OnChannelSectionChannelsRemoved(string, []string)            {}
+func (*watchHandler) OnPrefChange(string, string)                                 {}
+func (*watchHandler) OnMemberJoined(string, string)                               {}
+func (*watchHandler) OnMemberLeft(string, string)                                 {}
+func (*watchHandler) OnUserStatusChange(string, slackclient.UserStatus)           {}
+func (*watchHandler) OnUserInvalidated(string)                                    {}
+func (*watchHandler) OnDNDInvalidated(string)                                     {}
+func (*watchHandler) OnUserDNDChange(string, bool, int64)                         {}
+func (*watchHandler) OnEmojiChanged(string, string, []string, string)             {}
diff --git a/cmd/slk/watch_command_test.go b/cmd/slk/watch_command_test.go
